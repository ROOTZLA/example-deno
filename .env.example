# DollarDeploy injects these at runtime via the systemd EnvironmentFile.
# Listed here for documentation / local use only -- the start task does NOT
# load an env file, it reads Deno.env directly.

# Port the server binds to (DollarDeploy default for Deno apps is 3000).
PORT=3000

# Interface to bind to. DollarDeploy sets this to 127.0.0.1 behind its proxy.
HOSTNAME=127.0.0.1

# Set to "production" by DollarDeploy on deploy.
NODE_ENV=development
